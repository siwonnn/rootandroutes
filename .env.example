SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store only its SHA-256 hash in private.gateway_config; see README.
SUBMISSION_GATEWAY_SECRET=
# Run node scripts/setup-admin.cjs after creating .env.local.
# Server-only values; never prefix these with NEXT_PUBLIC_.
# Set your administrator login password directly (maximum 256 characters).
ADMIN_PASSWORD=
ADMIN_GATEWAY_SECRET=
SITE_URL=http://localhost:3000
# Vercel uses its own trusted proxy header automatically.
# Other hosts: only set this if your proxy overwrites this header on EVERY request.
TRUSTED_IP_HEADER=
# Production builds on localhost only, never on a deployed website:
ALLOW_LOCAL_TESTING=false
DEMO_MODE=false
